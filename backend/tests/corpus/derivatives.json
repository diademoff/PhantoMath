{
  "module": "derivatives",
  "tasks": [
    {
      "id": "x-squared",
      "title": "производная x^2",
      "input": "{derivation_prime({x^2})}",
      "solution": {
        "type": "MULTIPLY_IMPLICIT",
        "children": [
          {"type": "CONSTANT", "value": "2"},
          {"type": "VARIABLE", "value": "x"}
        ]
      },
      "steps": ["find_derivative"]
    },
    {
      "id": "polynomial",
      "title": "производная 3x^2 + 2x",
      "input": "{derivation_prime({3x^2+2x})}",
      "solution": {
        "type": "ADD",
        "children": [
          {
            "type": "MULTIPLY_IMPLICIT",
            "children": [
              {"type": "CONSTANT", "value": "6"},
              {"type": "VARIABLE", "value": "x"}
            ]
          },
          {"type": "CONSTANT", "value": "2"}
        ]
      },
      "steps": ["find_derivative"]
    },
    {
      "id": "sine",
      "title": "производная sin x",
      "input": "{derivation_prime({sin({x})})}",
      "solution": {"type": "COS", "children": [{"type": "VARIABLE", "value": "x"}]},
      "steps": ["find_derivative"]
    },
    {
      "id": "sine-chain-rule",
      "title": "цепное правило: производная sin(2x)",
      "input": "{derivation_prime({sin({2x})})}",
      "solution": {
        "type": "MULTIPLY_IMPLICIT",
        "children": [
          {"type": "CONSTANT", "value": "2"},
          {
            "type": "COS",
            "children": [
              {
                "type": "MULTIPLY_IMPLICIT",
                "children": [
                  {"type": "CONSTANT", "value": "2"},
                  {"type": "VARIABLE", "value": "x"}
                ]
              }
            ]
          }
        ]
      },
      "steps": ["find_derivative"]
    },
    {
      "id": "reciprocal",
      "title": "производная 1/x",
      "input": "{derivation_prime({1/x})}",
      "solution": {
        "type": "FRACTION",
        "children": [
          {"type": "CONSTANT", "value": "-1"},
          {
            "type": "POWER",
            "children": [
              {"type": "VARIABLE", "value": "x"},
              {"type": "CONSTANT", "value": "2"}
            ]
          }
        ]
      },
      "steps": ["find_derivative"]
    },
    {
      "id": "square-root",
      "title": "производная sqrt(x)",
      "input": "{derivation_prime({root2({x})})}",
      "solution": {
        "type": "FRACTION",
        "children": [
          {"type": "CONSTANT", "value": "1"},
          {
            "type": "MULTIPLY_IMPLICIT",
            "children": [
              {"type": "CONSTANT", "value": "2"},
              {"type": "ROOT2", "children": [{"type": "VARIABLE", "value": "x"}]}
            ]
          }
        ]
      },
      "steps": ["find_derivative"]
    }
  ]
}
