   "steps": [
    {
     "headers": [
      "Приведём уравнение к стандартному виду"
     ],
     "stages": [
      {
       "key": "eq_quad_coeff_identify",
       "text": "В стандартном виде ax² + bx + c = 0 коэффициенты равны: a = 1, b = -5, c = 6.",
       "detail": [],
       "theory": true
      }
     ]
    },
    {
     "headers": [
      "Найдём дискриминант"
     ],
     "stages": [
      {
       "key": "eq_quad_disc",
       "text": "Запишем D = b² − 4ac и подставим коэффициенты вместе с их знаками.",
       "detail": [],
       "theory": true
      },
      {
       "key": "eq_quad_disc_calculate",
       "text": "Вычислим значение дискриминанта: D = 1. По его знаку определяем число действительных корней.",
       "detail": [
        {
         "headers": [
          "Найдём дискриминант"
         ],
         "stages": [
          {
           "key": "lesson_disc_square",
           "text": "Сначала возведём коэффициент b в квадрат. Скобки сохраняют знак отрицательного числа.",
           "detail": [],
           "theory": true
          },
          {
           "key": "lesson_disc_product",
           "text": "Вычислим произведение 4ac, учитывая знаки коэффициентов.",
           "detail": [],
           "theory": true
          },
          {
           "key": "lesson_disc_subtract",
           "text": "Вычтем 4ac из b². Полученное число — дискриминант D.",
           "detail": [],
           "theory": true
          }
         ]
        }
       ],
       "theory": true
      }
     ]
    },
    {
     "headers": [
      "Найдём корни"
     ],
     "stages": [
      {
       "key": "eq_quad_solve_in_r",
       "text": "Подставим дискриминант в формулу корней. Вычислим ветви со знаком минус и плюс; при D = 0 они совпадают.",
       "detail": [
        {
         "headers": [
          "Подставим значения в формулу"
         ],
         "stages": [
          {
           "key": "lesson_root_formula",
           "text": "Используем формулу корней для ax² + bx + c = 0, где a ≠ 0.",
           "detail": [],
           "theory": true
          }
         ]
        },
        {
         "headers": [
          "Вычислим корень со знаком минус"
         ],
         "stages": [
          {
           "key": "lesson_root_sqrt",
           "text": "Упростим квадратный корень из дискриминанта; иррациональное значение оставим точным.",
           "detail": [],
           "theory": true
          },
          {
           "key": "lesson_root_numerator",
           "text": "Вычислим числитель этой ветви формулы.",
           "detail": [],
           "theory": true
          },
          {
           "key": "lesson_root_denominator",
           "text": "Вычислим знаменатель 2a. Он не равен нулю.",
           "detail": [],
           "theory": true
          },
          {
           "key": "lesson_root_reduce",
           "text": "Упростим полученную дробь и запишем корень.",
           "detail": [],
           "theory": true
          }
         ]
        },
        {
